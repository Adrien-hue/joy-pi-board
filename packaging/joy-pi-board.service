[Unit]
Description=Joy Pi Board LAN overview
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=joy-pi-board
Group=joy-pi-board
WorkingDirectory=/
UMask=0077
EnvironmentFile=-/etc/default/joy-pi-board
ExecStart=/usr/bin/joy-pi-board
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=joy-pi-board
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=6s

[Install]
WantedBy=multi-user.target
