{
  "name": "joy-pi-board-web",
  "version": "0.1.0-s00",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "preinstall": "node ../scripts/tasks.mjs tools",
    "tools": "node ../scripts/tasks.mjs tools",
    "check": "node ../scripts/tasks.mjs check",
    "contract": "node ../scripts/tasks.mjs contract",
    "fuzz": "node ../scripts/tasks.mjs fuzz",
    "build": "node ../scripts/tasks.mjs build",
    "cross": "node ../scripts/tasks.mjs cross",
    "race": "node ../scripts/tasks.mjs race",
    "smoke": "node ../scripts/tasks.mjs smoke",
    "sizes": "node ../scripts/tasks.mjs sizes",
    "missing-dist": "node ../scripts/tasks.mjs missing-dist",
    "dev": "node ../scripts/tasks.mjs dev",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/tasks.mjs lint",
    "format:check": "prettier --check src index.html *.json *.ts *.tsx *.js ../scripts/*.mjs ../toolchains.json ../.github/workflows/*.yml",
    "format": "prettier --write src index.html *.json *.ts *.tsx *.js ../scripts/*.mjs ../toolchains.json ../.github/workflows/*.yml",
    "test": "vitest run",
    "build:frontend": "node ../scripts/tasks.mjs frontend",
    "browser": "node ../scripts/tasks.mjs browser"
  },
  "dependencies": {
    "lossless-json": "4.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
